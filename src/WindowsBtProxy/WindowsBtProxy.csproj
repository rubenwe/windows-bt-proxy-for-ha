<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>windows-bt-proxy</AssemblyName>
    <RootNamespace>WindowsBtProxy</RootNamespace>
    <!-- Shown by `version` and reported to Home Assistant in server_info. -->
    <Version>0.1.0</Version>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- dnsapi.dll interop (Discovery/DnsSdAdvertiser.cs) uses pointers and function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- consoleAllocationPolicy=detached (Windows 11 24H2+): no console window unless ConsoleAttach asks for one. See docs/decisions.md. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="all" />
    <!-- Generic Host with the Windows service lifetime (SCM start/stop) and the Event Log provider. Console logging is for `run`. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\*.proto" GrpcServices="None" ProtoRoot="..\..\proto" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests reach test-only seams such as CipherState's starting nonce. -->
    <InternalsVisibleTo Include="WindowsBtProxy.Tests" />
  </ItemGroup>

</Project>
